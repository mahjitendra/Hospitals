# Application Configuration
APP_NAME="College ERP"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_VERSION=1.0.0

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=college_erp
DB_USERNAME=root
DB_PASSWORD=

# Cache Configuration
CACHE_DRIVER=file
CACHE_PREFIX=college_erp_cache

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=college_erp_session
SESSION_SECURE_COOKIE=false

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@college.edu
MAIL_FROM_NAME="${APP_NAME}"

# SMS Configuration
SMS_DRIVER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Payment Gateway Configuration
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# Security Configuration
CSRF_PROTECTION=true
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
PASSWORD_MIN_LENGTH=8

# Backup Configuration
BACKUP_NOTIFICATION_EMAIL=admin@college.edu
BACKUP_RETENTION_DAYS=30

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."
MAINTENANCE_ALLOWED_IPS=

# Logging Configuration
LOG_LEVEL=debug
LOG_MAX_FILES=10
LOG_MAX_SIZE=10485760

# Third-party Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Biometric Integration
BIOMETRIC_ENABLED=false
BIOMETRIC_DEVICE_IP=
BIOMETRIC_DEVICE_PORT=

# Academic Configuration
CURRENT_SESSION=2024-25
SESSION_START_MONTH=4
SESSION_END_MONTH=3
DEFAULT_SEMESTER_DURATION=6

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false

# Report Settings
REPORTS_CACHE_TTL=3600
REPORTS_MAX_RECORDS=10000

# API Configuration
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY=3600

# External Services
WEATHER_API_KEY=
MAPS_API_KEY=
ANALYTICS_TRACKING_ID=

# Development Settings
QUERY_LOG=false
PERFORMANCE_LOG=false
DEBUG_BAR=false