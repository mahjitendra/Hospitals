# --------------------------------------------------------------------------
# Environment Variables
# --------------------------------------------------------------------------
#
# This file is an example. For your local development, you should copy this
# file to a new file named `.env` and fill in the correct values.
# The `.env` file is ignored by Git to keep your sensitive credentials secure.
#

# -- Application Settings --
# Set the application environment: development, testing, staging, production
APP_ENV=development
# The base URL of your application
APP_URL=http://localhost:8000

# -- Database Connection --
# The database driver (e.g., mysql, pgsql, sqlite)
DB_DRIVER=mysql
# The database host (e.g., 127.0.0.1, localhost)
DB_HOST=127.0.0.1
# The database port (e.g., 3306 for MySQL, 5432 for PostgreSQL)
DB_PORT=3306
# The name of the database
DB_NAME=hospital_erp
# The database user
DB_USER=root
# The password for the database user (leave blank if none)
DB_PASS=

# -- Email Configuration (Example) --
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# -- API Keys (Example) --
# THIRD_PARTY_API_KEY=
